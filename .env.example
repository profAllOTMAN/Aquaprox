# Valeurs publiques intégrées au build (Vercel ou Docker)
NEXT_PUBLIC_SITE_URL=https://experience.aquaprox.com
NEXT_PUBLIC_QR_URL=https://aquaprox.com/
NEXT_PUBLIC_CONTACT_MODE=demo
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# vector = maquette actuelle ; rendered = images Blender dans public/assets/scenes
NEXT_PUBLIC_VISUAL_MODE=vector

# Secrets serveur — ne jamais préfixer par NEXT_PUBLIC_
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
