[Unit]
Description=AQUAPROX Chromium kiosk
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/aquaprox-kiosk.env
ExecStart=/opt/aquaprox/deploy/kiosk/start-browser.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
